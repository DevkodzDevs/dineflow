{
  "name": "dineflow",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "setup": "node launcher.mjs",
    "start": "node launcher.mjs local",
    "deploy": "node launcher.mjs live",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @dineflow/web dev",
    "dev:mobile": "pnpm --filter @dineflow/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @dineflow/db generate",
    "db:push": "pnpm --filter @dineflow/db push"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}