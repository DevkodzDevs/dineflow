{
  "expo": {
    "name": "DineFlow",
    "slug": "dineflow",
    "scheme": "dineflow",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#14261f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.dineflow.app"
    },
    "android": {
      "package": "in.dineflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#14261f"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "DineFlow uses the camera to scan barcodes, QR labels, products, dishes, rooms and ID cards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DineFlow can read a photo from your gallery to recognise a product."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cb821e3a-5482-40ce-8f92-753eb8d81e49"
      }
    }
  }
}
