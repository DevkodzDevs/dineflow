# Copy to .env.local — the launcher writes this for you.
# The only two values DineFlow actually needs:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-anon-key

# ── Everything below is optional. Leave the dummy values and the app still runs. ──

# Photo recognition on the Scan page. Without it, photos return a clearly-marked sample result
# and barcode/QR scanning works normally. Real key from console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-dummy-key-scanning-runs-in-sample-mode

# Only needed if you want webhook and iCal traffic to bypass row-level security.
# Not required: those endpoints authenticate with their own per-channel token.
SUPABASE_SERVICE_ROLE_KEY=

# Protects the scheduled OTA sync when it runs on a cron. Any string.
CRON_SECRET=dineflow-dummy-cron-secret

# Where the LAN print bridge listens (only change if 9110 is taken).
NEXT_PUBLIC_PRINT_BRIDGE=http://localhost:9110
