{
  "name": "@dineflow/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "DineFlow as a Windows application — a window around the deployed app.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "in.dineflow.desktop",
    "productName": "DineFlow",
    "copyright": "DineFlow",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.cjs", "unreachable.html", "build/icon.png"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "DineFlow-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DineFlow",
      "deleteAppDataOnUninstall": false
    }
  }
}
