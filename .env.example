# Copy to apps/web/.env.local and apps/mobile/.env
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# packages/db only (never ship to clients)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# ── Sending one-time codes (apps/web only) ────────────────────────────────────
# Needed for: confirming a new member of staff's email, and letting anyone reset
# a forgotten password. Without it both still work, but the code has nowhere to
# go — staff are created unconfirmed and a lost password needs Master control.
#   resend.com → API keys, and a sender on a domain you have verified there
RESEND_API_KEY=re_...
EMAIL_FROM=DineFlow <no-reply@yourdomain.in>
# Testing on a machine with no mail account: show the code on screen instead of
# sending it. Never set this on anything reachable from the internet.
DINEFLOW_OTP_ECHO=1
