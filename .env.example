# Copy to apps/web/.env.local and apps/mobile/.env
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# packages/db only (never ship to clients)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# ── The address this app answers on (apps/web only) ───────────────────────────
# Used for the links a property hands out — Proof of business, channel webhooks,
# the booking page and the storefront — and for the preview image on anything
# shared to WhatsApp or picked up by a search engine. Leave it unset in local
# development and everything falls back to http://localhost:3000.
NEXT_PUBLIC_CLOUD_URL=https://yourdomain.in

# ── Where the installers live (apps/web only) ─────────────────────────────────
# The /get page hands people the right file for the device they are holding. These
# point at wherever a release actually sits — a GitHub release, object storage, any
# file server. Left unset, that device's button reads "not published yet" instead of
# sending somebody to a dead link.
NEXT_PUBLIC_DOWNLOAD_WINDOWS=https://.../DineFlow-Setup-1.0.0.exe
NEXT_PUBLIC_DOWNLOAD_ANDROID=https://.../dineflow-1.0.0.apk

# ── The model behind the AI features (apps/web only) ──────────────────────────
# Assist on every screen, photo recognition in Scan, and the suggestion buttons:
# filling in a dish and its recipe from the pantry, matching Swiggy/Zomato lines
# to the menu, drafting review replies, writing the storefront tagline.
# Everything it produces is a suggestion a person then saves. Leave it unset and
# every one of those buttons simply does not appear; nothing else changes.
#   console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Sending one-time codes (apps/web only) ────────────────────────────────────
# Needed for: confirming a new member of staff's email, and letting anyone reset
# a forgotten password. Without it both still work, but the code has nowhere to
# go — staff are created unconfirmed and a lost password needs Master control.
#   resend.com → API keys, and a sender on a domain you have verified there
RESEND_API_KEY=re_...
EMAIL_FROM=DineFlow <no-reply@yourdomain.in>
# Testing on a machine with no mail account: show the code on screen instead of
# sending it. Never set this on anything reachable from the internet.
DINEFLOW_OTP_ECHO=1
